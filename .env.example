# Copier ce fichier vers .env puis remplir les valeurs.
# Tant que SMTP_USER et SMTP_PASS sont vides, les codes s'affichent
# simplement dans le terminal (mode test, pratique pour démarrer).

# Port du serveur (par défaut 3000)
PORT=3000

# Secret pour les sessions (n'importe quelle longue chaîne aléatoire).
# Si vide, un secret est régénéré à chaque démarrage (les sessions sont perdues).
SESSION_SECRET=

# --- Envoi d'emails via iCloud -------------------------------------------
# 1. Activez l'authentification à deux facteurs sur votre compte Apple.
# 2. Générez un "mot de passe pour app" :
#    https://account.apple.com/account/manage  →  Sécurité  →  Mots de passe pour app
# 3. Renseignez ci-dessous votre adresse iCloud et ce mot de passe d'application.

SMTP_USER=
SMTP_PASS=

# Adresse d'expédition affichée aux destinataires (par défaut = SMTP_USER)
MAIL_FROM=
